# 실제 서버 시험에만 쓰는 API 키입니다. 앱은 이 파일을 읽지 않습니다.
# (앱의 키는 설정 화면에서 넣고 macOS 키체인에만 둡니다.)
#
# 쓰는 법
#   cp app/.env.example app/.env        # .env는 git이 무시합니다
#   값을 채운 뒤, 시험을 돌릴 때 KARI_ENV로 이 파일의 절대 경로를 줍니다.
#   자세한 것: Docs/contributing/build-and-test.md의 "실제 서버 시험"
#
# 실제 요금이 듭니다. 값이 빈 제공사의 시험은 건너뜁니다.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
